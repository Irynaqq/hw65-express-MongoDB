doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= title
    link(rel="icon" href="/favicon.ico")
    link(rel="stylesheet" href="/styles.css")
  body(class=theme)
    .container
      h1 User Details

      .theme-switch
        a.btn(href=`/set-theme/light?redirect=/users/${user.id}`) Light
        a.btn(href=`/set-theme/dark?redirect=/users/${user.id}`) Dark

      p ID: #{user.id}
      p Name: #{user.name}
      p Email: #{user.email}

      a(href="/users") Back to users