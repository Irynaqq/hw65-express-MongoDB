<!DOCTYPE html>
<html lang="en">

  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
      <%= title %>
    </title>

    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/styles.css" />
  </head>

  <body class="<%= theme %>">
    <div class="container">
      <h1>Articles List</h1>

      <div class="theme-switch">
        <a class="btn" href="/set-theme/light?redirect=/articles">Light</a>
        <a class="btn" href="/set-theme/dark?redirect=/articles">Dark</a>
      </div>

      <ul>
        <% articles.forEach(article=> { %>
          <li>
            <a href="/articles/<%= article.id %>">
              <%= article.title %> — <%= article.description %>
            </a>
          </li>
          <% }) %>
      </ul>
    </div>
  </body>

</html>